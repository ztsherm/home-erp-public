yarn-error.log*
.pnpm-debug.log*
.next-dev.*.log
.codex-run/

# local editor and agent tooling
.codex/
.vscode/
.vexp/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
